{
  "name": "@devdigest/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP server exposing DevDigest tools to Claude Code",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/devdigest-mcp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs src"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.20.1",
    "dependency-cruiser": "^16.10.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
